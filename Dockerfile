FROM node:22-alpine

ARG DEMO_MODE
ARG PUBLIC_DATA_DONATION_ENABLED
ARG DEMO_SHOW_HAS_TOKEN_BUTTON
ARG UPLOAD_TEST_ENABLED
ARG CONSENT_ENABLED
ARG TOKEN_REQUIRED
ARG DUPLICATE_DONATION_CHECK_ENABLED
ARG DUPLICATE_CHECK_CSV_DOWNLOAD_ENABLED
ARG ENABLED_LANGUAGES
ARG DEFAULT_LANGUAGE
ARG BROWSER_LANGUAGE_ENABLED
ARG ENABLED_DATA_SOURCES
ARG DONOR_ID_INPUT_METHOD
ARG DONOR_SURVEY_ENABLED
ARG FEEDBACK_SURVEY_ENABLED
ARG DONOR_SURVEY_LINK
ARG FEEDBACK_SURVEY_LINK
ARG NEXT_PUBLIC_MIN_CHATS_FOR_DONATION
ARG NEXT_PUBLIC_MIN_MESSAGES_PER_CHAT
ARG NEXT_PUBLIC_MIN_CONTACTS_PER_CHAT
ARG NEXT_PUBLIC_MAX_FEEDBACK_CHATS
ARG NEXT_PUBLIC_MIN_FEEDBACK_CHATS
ARG NEXT_PUBLIC_DEFAULT_FEEDBACK_CHATS
ARG NEXT_PUBLIC_MIN_MESSAGES_FOR_DUPLICATE_CHECK

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN mkdir -p public/sql-wasm

ENV HUSKY=0
# Keep the pnpm version in sync with "packageManager" in package.json
RUN npm install -g pnpm@12.15.0 && pnpm install --frozen-lockfile

COPY . .

RUN pnpm build

EXPOSE 3000
