# Dona environment configuration
#
# Copy this file to `.env` and adjust it. Each variable is marked as
# [required] (the app or docker-compose does not start without it) or
# [optional] (with the default that applies when it is not set or left empty).
#
# Most settings are read when the app is BUILT (`pnpm build`, `docker compose build`),
# not when it is started. After changing them, rebuild the app.
# Boolean values must be exactly `true` or `false`.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# [required for docker-compose] Database name, user, and password of the Postgres container.
POSTGRES_DB=dona
POSTGRES_USER=dona
POSTGRES_PASSWORD=password

# [required] Postgres connection string used by the app and by drizzle-kit migrations.
# In docker-compose, it is set automatically from the POSTGRES_* values above.
DATABASE_URL=postgres://dona:password@localhost:5432/dona

# ---------------------------------------------------------------------------
# Ports and development
# ---------------------------------------------------------------------------

# [optional] Port the Next.js server listens on (`pnpm dev` / `pnpm start`). Default: 3000
# Keep it at 3000 when using docker-compose; the container port is mapped as `<host port>:3000`.
PORT=3000

# Currently NOT read by docker-compose.yml: the host ports are fixed there (app 9018, Postgres 5572).
# APP_PORT=3000
# APP_INTERNAL_PORT=3000
# POSTGRES_HOST_PORT=5432

# [optional] Comma-separated origins allowed to access the dev server and to call server actions.
# Default: 127.0.0.1,127.0.0.1:3000,127.0.0.1:9012,localhost:3000
NEXT_ALLOWED_DEV_ORIGINS=127.0.0.1,127.0.0.1:3000,127.0.0.1:9012,localhost:3000

# ---------------------------------------------------------------------------
# Donation flow
# ---------------------------------------------------------------------------

# [optional] Demo mode: no data is stored, no duplicate check, demo notices in the flow,
# sample data downloads on the instructions page, disabled consent PDF download,
# and no final survey call to action. Default: false
DEMO_MODE=true

# [optional] Show the "I have received my token" button on the landing page in demo mode. Default: false
DEMO_SHOW_HAS_TOKEN_BUTTON=false

# [optional] Require an enrollment token: the landing page shows the sign-up link and the
# "I have received my token" button. With false, it shows a "Donate" button instead. Default: true
TOKEN_REQUIRED=false

# [optional] Show the test upload page (/upload-test) between the instructions and the consent,
# where donors check that their files can be processed. Default: true
UPLOAD_TEST_ENABLED=false

# [optional] Show the declaration of consent before the donation. With false, the consent is
# skipped, but the donor ID step and the donor survey redirect still take place. Default: true
CONSENT_ENABLED=true

# [required] How the external donor ID is obtained:
#   automated - generated automatically, never shown to the donor
#   showid    - generated automatically and shown to the donor to remember
#   manually  - entered by the donor
DONOR_ID_INPUT_METHOD=automated

# [required] Redirect donors to the donor survey (DONOR_SURVEY_LINK) before the donation.
DONOR_SURVEY_ENABLED=false

# [required] Show the feedback survey (FEEDBACK_SURVEY_LINK) at the end of the donation.
FEEDBACK_SURVEY_ENABLED=false

# [required] Survey links. Must be valid URLs, even when the surveys are disabled.
DONOR_SURVEY_LINK=https://survey.mbp.tf.uni-bielefeld.de/index.php?r=survey/index&sid=453492
FEEDBACK_SURVEY_LINK=https://survey.mbp.tf.uni-bielefeld.de/index.php?r=survey/&sid=158878

# ---------------------------------------------------------------------------
# Data sources
# ---------------------------------------------------------------------------

# [optional] Comma-separated data sources offered for donation.
# Values: WhatsApp|WA, Facebook|FB, Instagram|IG, IMessage|IMSG
# Default: WhatsApp,Facebook,Instagram,IMessage (also used if no valid value is given)
ENABLED_DATA_SOURCES=FB,IG

# [optional] Also collect Facebook/Instagram posts, comments, and reactions (counts and
# timestamps only) and show charts about them in the feedback. Default: false
PUBLIC_DATA_DONATION_ENABLED=true

# ---------------------------------------------------------------------------
# Languages
# ---------------------------------------------------------------------------

# [optional] Comma-separated UI languages offered. Supported: en, de, hy. Default: en,de,hy
# The app does not start if an unsupported language is listed.
ENABLED_LANGUAGES=en,hy

# [optional] Language used when no other language is selected. Must be one of ENABLED_LANGUAGES,
# otherwise the app does not start. Default: en
DEFAULT_LANGUAGE=en

# [optional] Use the browser language when the donor has not selected a language yet. Default: false
BROWSER_LANGUAGE_ENABLED=false

# ---------------------------------------------------------------------------
# Donation eligibility and feedback
# Positive numbers only; invalid values fall back to the default.
# ---------------------------------------------------------------------------

# [optional] Minimum number of chats a donation must contain. Default: 5
NEXT_PUBLIC_MIN_CHATS_FOR_DONATION=5

# [optional] Minimum number of messages for a chat to count towards the eligibility. Default: 100
NEXT_PUBLIC_MIN_MESSAGES_PER_CHAT=3

# [optional] Minimum number of participants for a chat to count towards the eligibility. Default: 2
NEXT_PUBLIC_MIN_CONTACTS_PER_CHAT=2

# [optional] Number of chats donors can select for the feedback: maximum, minimum, and preselected.
# Defaults: 10, 3, 5
NEXT_PUBLIC_MAX_FEEDBACK_CHATS=10
NEXT_PUBLIC_MIN_FEEDBACK_CHATS=3
NEXT_PUBLIC_DEFAULT_FEEDBACK_CHATS=5

# ---------------------------------------------------------------------------
# Duplicate donation check
# ---------------------------------------------------------------------------

# [optional] Reject donations containing conversations that were already donated.
# Conversation hashes are stored either way, so the check also covers donations made while
# it was disabled. Always off in demo mode. Default: true
DUPLICATE_DONATION_CHECK_ENABLED=false

# [optional] Minimum number of messages (text + audio) for a conversation to be hashed and
# checked for duplicates. Default: 50
NEXT_PUBLIC_MIN_MESSAGES_FOR_DUPLICATE_CHECK=10

# [optional] Show the "Download Duplicate-Check CSV" button on the donation page. Only meant for
# collecting hashes of test exports, see DUPLICATE_CHECK_EXCEPTION_HASHES_CSV_PATH. Default: false
DUPLICATE_CHECK_CSV_DOWNLOAD_ENABLED=false

# [optional] CSV file with conversation hashes that are excluded from the duplicate check
# (e.g. test exports). Read at runtime; restart the app after changing the file.
# Default: public/documents/sample-data/duplicate-check-exceptions.csv
DUPLICATE_CHECK_EXCEPTION_HASHES_CSV_PATH=public/documents/sample-data/duplicate-check-exceptions.csv
